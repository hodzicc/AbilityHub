{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:8090" ]
  },

  "Jwt": {
    "Issuer": "AbilityHub",
    "Audience": "AbilityHubClients",
    "Key": "kazc733ms0aoebss1948unelsk374n12"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "apps-route": {
        "ClusterId": "appregistry-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/apps/{**catch-all}" }
      },
      "settings-route": {
        "ClusterId": "settings-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/settings/{**catch-all}" }
      },
      "usage-route": {
        "ClusterId": "usage-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/usage/{**catch-all}" }
      },
      "checkins-route": {
        "ClusterId": "usage-cluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/checkins/{**catch-all}" }
      },
      "settings-hub-route": {
        "ClusterId": "settings-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/hubs/settings/{**catch-all}" }
      },
      "usage-hub-route": {
        "ClusterId": "usage-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/hubs/usage/{**catch-all}" }
      },

      "auth-docs-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api-docs/auth" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "users-docs-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api-docs/users" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "apps-docs-route": {
        "ClusterId": "appregistry-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api-docs/apps" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "settings-docs-route": {
        "ClusterId": "settings-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api-docs/settings" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "usage-docs-route": {
        "ClusterId": "usage-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api-docs/usage" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "auth": { "Address": "http://auth:8080/" } }
      },
      "users-cluster": {
        "Destinations": { "users": { "Address": "http://users:8080/" } }
      },
      "appregistry-cluster": {
        "Destinations": { "appregistry": { "Address": "http://appregistry:8080/" } }
      },
      "settings-cluster": {
        "Destinations": { "settings": { "Address": "http://settings:8080/" } }
      },
      "usage-cluster": {
        "Destinations": { "usage": { "Address": "http://usage:8080/" } }
      }
    }
  }
}
